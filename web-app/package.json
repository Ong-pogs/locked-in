{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:desktop": "playwright test --config e2e/playwright.config.ts --project=desktop-chrome",
    "test:e2e:mobile": "playwright test --config e2e/playwright.config.ts --project=mobile-iphone",
    "typecheck": "tsc --noEmit",
    "test:e2e:v2": "playwright test --config e2e/playwright.v2.config.ts",
    "test:visual": "playwright test --config e2e/visual.config.ts",
    "test:visual:update": "playwright test --config e2e/visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.36.0",
    "@solana-program/memo": "^0.11.0",
    "@solana-program/system": "^0.12.0",
    "@solana-program/token": "^0.12.0",
    "@solana/client": "^1.7.0",
    "@solana/kit": "^6.5.0",
    "@solana/react-hooks": "^1.4.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3-compat": "^0.0.21",
    "@solana/web3.js": "^1.98.4",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serwist": "^9.5.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@serwist/turbopack": "^9.5.7",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "esbuild": "^0.27.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
