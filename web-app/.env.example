# ============================================================
# Locked In web environment - safe local/devnet example
# ============================================================
# Copy to .env.local for local development. These values deliberately do not
# enable the v2 mainnet custody path. Production truth lives in
# ../config/mainnet-production.json and scripts/deploy/env.mainnet.frontend.template.
# ============================================================

# Backend API (Fastify on Render)
NEXT_PUBLIC_API_URL=https://locked-in-backend-oetf.onrender.com

# Optional legacy dungeon embed
NEXT_PUBLIC_DUNGEON_URL=https://dungeon-vert.vercel.app

# Privy public application ID
NEXT_PUBLIC_PRIVY_APP_ID=cmncshird026v0cl5n6yqq8z0

# Solana devnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com

# Legacy merged program retained only for code paths that still import v1.
NEXT_PUBLIC_LOCK_VAULT_PROGRAM_ID=3RC9XkPZNSgXksp9Fb7J4LE7cQNYUUQdxkaaQnz6kBav

# Devnet USDC. Leave the v2 program unset so a copied example cannot point a
# local UI at live mainnet custody.
NEXT_PUBLIC_LOCK_VAULT_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# NEXT_PUBLIC_VAULT_V2_PROGRAM_ID=<explicit-devnet-v2-program>

# Set only alongside an explicit devnet v2 program.
# NEXT_PUBLIC_KAMINO_SCOPE_PRICES=<devnet-scope-prices-account>
