# ============================================================
# Locked In web environment - production/mainnet manifest
# ============================================================
# Production is live on mainnet. These values are public because every
# NEXT_PUBLIC_* value ships in the browser bundle. RPC URLs may still contain
# paid credentials, so use provider-restricted keys and never commit a real URL.
#
# For local devnet/E2E values, use the explicit values in the Playwright
# configs and CI. Do not switch this canonical production manifest to devnet.
# ============================================================

# Backend API (Fastify on Render)
NEXT_PUBLIC_API_URL=https://locked-in-backend-oetf.onrender.com

# Optional legacy dungeon embed
NEXT_PUBLIC_DUNGEON_URL=https://dungeon-vert.vercel.app

# Privy public application ID
NEXT_PUBLIC_PRIVY_APP_ID=cmncshird026v0cl5n6yqq8z0

# Solana mainnet. Replace the placeholders with a browser-restricted paid RPC.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC_URL=https://your-mainnet-rpc.example
NEXT_PUBLIC_SOLANA_WS_URL=wss://your-mainnet-rpc.example

# Legacy merged program retained only for code paths that still import v1.
NEXT_PUBLIC_LOCK_VAULT_PROGRAM_ID=3RC9XkPZNSgXksp9Fb7J4LE7cQNYUUQdxkaaQnz6kBav

# Active v2 mainnet custody program and canonical mainnet USDC.
NEXT_PUBLIC_VAULT_V2_PROGRAM_ID=FAuFtXbTAT9SiJTghxdZ1ZD4ShgrdTk2EqgyPxfq2gZ6
NEXT_PUBLIC_LOCK_VAULT_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Kamino Scope prices account used by the v2 refresh path.
NEXT_PUBLIC_KAMINO_SCOPE_PRICES=3t4JZcueEzTbVP6kLxXrL3VpWx45jDer4eqysweBchNH
