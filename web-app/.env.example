# ============================================================
# web-app environment variables — canonical manifest
# ============================================================
# Copy this file to `.env` to get started, OR run
#   vercel env pull .env
# to sync the authoritative values directly from Vercel.
#
# Every `NEXT_PUBLIC_*` var ships in the client bundle — none
# are secrets, but all are required for the app to work.
# ============================================================

# Backend API (Fastify on Render)
NEXT_PUBLIC_API_URL=https://locked-in-backend-oetf.onrender.com

# Dungeon iframe (Three.js static deploy on Vercel)
NEXT_PUBLIC_DUNGEON_URL=https://dungeon-vert.vercel.app

# Privy (wallet auth)
NEXT_PUBLIC_PRIVY_APP_ID=cmncshird026v0cl5n6yqq8z0

# Solana cluster + RPC (devnet)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com

# Solana Program IDs
# lock_vault + community_pot are now ONE merged on-chain program (`locked_in`),
# so both program-id vars point to the same merged ID.
NEXT_PUBLIC_LOCK_VAULT_PROGRAM_ID=68im45BCfv8sL6WnVVV9JF4edLkB11udeU9EAApNaEx3
NEXT_PUBLIC_LOCK_VAULT_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_LOCK_VAULT_SKR_MINT=CQAiXocPkmrr6MTDigHn1yDJ66v5nbPyxwMoUxb4PgST
# NOTE: the standalone yield_splitter + community_pot programs were merged into
# the single `locked_in` program. The web-app reads only the LOCK_VAULT_*
# program id above; the old NEXT_PUBLIC_YIELD_SPLITTER_PROGRAM_ID /
# NEXT_PUBLIC_COMMUNITY_POT_PROGRAM_ID vars are unused and were removed.
