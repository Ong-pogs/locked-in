# ── Mainnet backend env (Render web service) ────────────────────────────────
# Template only. Fill the <...> values; NEVER commit real secrets/keys.
# The backend boot guards refuse to start on a non-devnet RPC with dev-fallback
# secrets or a dev/demo yield profile behind a v2 program.

# --- cluster / RPC (detectCluster keys off this URL; must NOT contain 'devnet') ---
SOLANA_RPC_URL=https://<your-paid-mainnet-rpc>

# --- v2 vault custody (the merged locked_in program on mainnet) ---
VAULT_V2_PROGRAM_ID=FAuFtXbTAT9SiJTghxdZ1ZD4ShgrdTk2EqgyPxfq2gZ6
COMMUNITY_POT_PROGRAM_ID=FAuFtXbTAT9SiJTghxdZ1ZD4ShgrdTk2EqgyPxfq2gZ6
LOCK_VAULT_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --- real Kamino yield (kamino_usdc_mainnet is the only profile allowed behind
#     a mainnet v2 program; pins the ACTIVE reserve, not the obsolete one) ---
YIELD_STRATEGY_ENABLED=true
YIELD_STRATEGY_PROFILE=kamino_usdc_mainnet
YIELD_KAMINO_RPC_URL=https://<your-paid-mainnet-rpc>
YIELD_KAMINO_RESERVE_ADDRESS=D6q6wuQSrifJKZYpR1M8R4YawnLDtDsMmWM1NbBmgJ59

# --- secrets (≥32 bytes; boot refuses 'dev-only-*' off-devnet) ---
JWT_SECRET=<32+ byte random>
SCHEDULER_SECRET=<32+ byte random>

# --- ops signing key (the voucher signer) ---
# CRITICAL: solana address -k <this key> MUST equal VAULT_AUTHORITY passed to
# init-mainnet-vault.mjs. claim_v2 verifies every voucher against config.authority.
# Keep DISTINCT from the program upgrade authority. Provide as bs58 of the
# 64-byte key. DO NOT set DEPLOYER_PRIVATE_KEY on Render (upgrade key stays cold).
LOCK_VAULT_WORKER_PRIVATE_KEY=<bs58 ops voucher key>
COMMUNITY_POT_WORKER_PRIVATE_KEY=<bs58 pot relay key>

# --- pot cron (Render cron service, monthly) ---
POT_CYCLE_BASE_URL=https://<your-backend-host>

# --- DB (unchanged from prod) ---
DATABASE_URL=<postgres url>
