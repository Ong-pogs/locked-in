PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=true
LOG_SINGLE_LINE=true

# Postgres / Supabase connection string
DATABASE_URL=

# HS256 signing secret for starter auth flow
JWT_SECRET=replace-with-long-random-secret
JWT_ISSUER=lockedin-api
JWT_AUDIENCE=lockedin-mobile
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
SCHEDULER_SECRET=replace-with-long-random-secret
MISS_EXTENSION_DAYS=7
LOCK_VAULT_RELAY_ENABLED=false
LOCK_VAULT_RELAY_INTERVAL_MS=15000
LOCK_VAULT_RELAY_BATCH_SIZE=5
REDEMPTION_VAULT_AUTOFUND_ENABLED=false
REDEMPTION_VAULT_AUTOFUND_INTERVAL_MS=30000
REDEMPTION_VAULT_MINIMUM_BALANCE_UI=1
REDEMPTION_VAULT_TARGET_BALANCE_UI=5
# Keep the in-process leaderboard worker off when cron owns refreshes.
LEADERBOARD_SNAPSHOT_ENABLED=false
LEADERBOARD_SNAPSHOT_INTERVAL_MS=60000
LEADERBOARD_SNAPSHOT_PAGE_SIZE=25
# Daily cron script target. Set this to your deployed backend base URL.
# Example Render command: npm run cron:leaderboard-refresh
LEADERBOARD_REFRESH_BASE_URL=
UNLOCK_INDEXER_ENABLED=false
UNLOCK_INDEXER_INTERVAL_MS=15000
UNLOCK_INDEXER_SCAN_LIMIT=25
RUNTIME_SCHEDULER_ENABLED=false
RUNTIME_SCHEDULER_INTERVAL_MS=15000
RUNTIME_SCHEDULER_BATCH_SIZE=5
# Non-MCQ lesson answers use the OpenAI grader by default.
# If OPENAI_API_KEY is missing, the backend fails those answers closed.
ANSWER_VALIDATOR_HYBRID_ENABLED=false
OPENAI_API_KEY=
OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
OPENAI_VALIDATOR_MODEL=gpt-5-nano
OPENAI_VALIDATOR_TIMEOUT_MS=4000

# Optional one-line yield profiles:
# - fixed_apy_dev
# - kamino_usdc_mainnet (weekly cadence so small dev locks stay above rounding noise)
# When a profile is set, it overrides the raw YIELD_* strategy fields below.
YIELD_STRATEGY_PROFILE=

YIELD_STRATEGY_ENABLED=false
YIELD_STRATEGY_KIND=fixed_apy_v1
YIELD_FIXED_APY_BPS=800
YIELD_HARVEST_INTERVAL_SECONDS=86400
YIELD_KAMINO_RPC_URL=https://api.mainnet-beta.solana.com
YIELD_KAMINO_MARKET_ADDRESS=7u3HeHxYDLhnCoErrtycNokbQYbWGzLs6JSDqGAv5PfF
YIELD_KAMINO_RESERVE_SYMBOL=USDC
YIELD_STRATEGY_APY_CACHE_MS=60000

# LockVault relay config
SOLANA_RPC_URL=https://api.devnet.solana.com
# lock_vault + community_pot are now ONE merged on-chain program (`locked_in`),
# so both IDs point to the same merged program ID.
LOCK_VAULT_PROGRAM_ID=3RC9XkPZNSgXksp9Fb7J4LE7cQNYUUQdxkaaQnz6kBav
COMMUNITY_POT_PROGRAM_ID=3RC9XkPZNSgXksp9Fb7J4LE7cQNYUUQdxkaaQnz6kBav
LOCK_VAULT_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
LOCK_VAULT_WORKER_PRIVATE_KEY=
COMMUNITY_POT_WORKER_PRIVATE_KEY=

# Devnet faucet — airdrops SOL + test USDC to new users
# Bump FAUCET_ROUND to let all users claim again (e.g. when launching new courses)
FAUCET_ENABLED=false
FAUCET_SOL_LAMPORTS=100000000
FAUCET_USDC_AMOUNT_UI=20
FAUCET_ROUND=1

# Comma-separated browser origins allowed to call this API
# Keep localhost + your LAN frontend URL here during development
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
