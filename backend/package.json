{
  "name": "locked-in-lesson-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "check": "node --check src/server.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:watch": "vitest watch --project unit",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@kamino-finance/klend-sdk": "^7.3.20",
    "@solana/kit": "^2.3.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "jose": "^6.0.0",
    "pg": "^8.16.0",
    "pino-pretty": "^13.1.3",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "vitest": "^4.1.4"
  }
}
